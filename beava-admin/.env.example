# Optional overrides (defaults in docker-compose.yml use the beava service):
# BEAVA_ADMIN_UPSTREAM=http://beava:8090
# BEAVA_DATA_UPSTREAM=http://beava:8080

# Admin-side RSS profiler (not beava-server). For local dev, run:
#   node server/memory-profile.mjs
# with one of:
# BEAVA_MEMORY_PID=12345
# BEAVA_CONTAINER_NAME=beava-admin-beava
# BEAVA_PROCESS_NAME=beava
# VITE_BEAVA_MEMORY_PROFILE_TARGET=http://127.0.0.1:8091
